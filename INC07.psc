Algoritmo INC07
	Definir A, B, C Como Enteros
	
	Escribir "Ingrese valores de A, B y C:"
	Escribir "A: "
	Leer A
	Escribir "B: "
	Leer B
	Escribir "C: "
	Leer C
	
	Si A + B = C
		Escribir "Iguales"
	SiNo
		Escribir "Distintas"
	FinSi
	
	Si A + C = B
		Escribir "Iguales"
	SiNo
		Escribir "Distintas"
	FinSi
	
	Si B + C = A
		Escribir "Iguales"
	SiNo
		Escribir "Distintas"
	FinSi
	
FinAlgoritmo
