Algoritmo INC08
	Definir X Como Entero
	Definir S Como Entero
	Definir suma Como Entero
	
	X <- 1
	S <- 0
	
	Escribir "Los primeros 50 numeros enteros"
	
	Mientras X <= 50 Hacer
		S <- S + X
		X <- X + 1
		Escribir X
	FinMientras
	
	Escribir "La suma de todos estos es: " S
	
FinAlgoritmo
