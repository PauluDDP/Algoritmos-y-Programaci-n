Algoritmo INC10
	Definir A, B, C Como Enteros
	
	Escribir "Define valores de A, B y C"
	Escribir "A: "
	Leer A
	Escribir "B: "
	Leer B
	Escribir "C: "
	Leer C
	
	Si A < B
		Si B < C
			Escribir "El valor mayor es " C
		SiNo
			Escribir "El valor mayor es " B
		FinSi
	SiNo
		Si A < C
			Escribir "El valor mayor es " C
		SiNo
			Escribir "El valor mayor es " A
		FinSi
	FinSi
	
FinAlgoritmo
